import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "TempestSDR — Rust/Slint Prototype";
    width: 1100px;
    height: 760px;
    background: #10141c;

    in property <image> video-frame;
    in property <string> display-name: "No display profile";
    in property <string> timing-summary: "";
    in-out property <string> status-text: "Initializing…";
    in-out property <string> plugin-path: "";
    in-out property <string> source-arguments: "driver=rtlsdr";
    in-out property <string> frequency-mhz: "154.000";
    in-out property <string> gain-percent: "50";
    in-out property <bool> capture-active: false;
    callback start-requested();
    callback stop-requested();

    VerticalBox {
        padding: 18px;
        spacing: 14px;

        Rectangle {
            height: 72px;
            border-radius: 10px;
            background: #182231;

            VerticalBox {
                padding: 12px;
                spacing: 4px;

                Text {
                    text: root.display-name;
                    color: #f1f5f9;
                    font-size: 20px;
                    font-weight: 700;
                }

                Text {
                    text: root.timing-summary;
                    color: #9fb1c5;
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }

        HorizontalBox {
            spacing: 14px;

            Rectangle {
                horizontal-stretch: 1;
                border-radius: 10px;
                background: #07090d;
                border-width: 1px;
                border-color: #2a3545;

                Image {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    source: root.video-frame;
                    image-fit: contain;
                }
            }

            Rectangle {
                width: 278px;
                background: #182231;
                border-radius: 10px;

                VerticalBox {
                    padding: 16px;
                    spacing: 12px;

                    Text {
                        text: "Capture";
                        color: #f1f5f9;
                        font-size: 18px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Frequency";
                        color: #9fb1c5;
                        font-size: 12px;
                    }

                    LineEdit {
                        height: 42px;
                        text <=> root.frequency-mhz;
                        placeholder-text: "Frequency in MHz";
                    }

                    Text {
                        text: "Source";
                        color: #9fb1c5;
                        font-size: 12px;
                    }

                    LineEdit {
                        height: 42px;
                        text <=> root.source-arguments;
                        placeholder-text: "driver=rtlsdr";
                    }

                    Text {
                        text: "Gain percent";
                        color: #9fb1c5;
                        font-size: 12px;
                    }

                    LineEdit {
                        height: 42px;
                        text <=> root.gain-percent;
                        placeholder-text: "0–100";
                    }

                    Text {
                        text: "Plugin";
                        color: #9fb1c5;
                        font-size: 12px;
                    }

                    LineEdit {
                        height: 42px;
                        text <=> root.plugin-path;
                        placeholder-text: "Path to TSDR source plugin";
                    }

                    Rectangle { vertical-stretch: 1; }

                    Button {
                        text: root.capture-active ? "Capture active" : "Start capture";
                        enabled: !root.capture-active;
                        clicked => { root.start-requested(); }
                    }

                    Button {
                        text: "Stop";
                        enabled: root.capture-active;
                        clicked => { root.stop-requested(); }
                    }
                }
            }
        }

        Rectangle {
            height: 42px;
            border-radius: 8px;
            background: #182231;

            Text {
                text: root.status-text;
                color: #a8d5ba;
                font-size: 12px;
                vertical-alignment: center;
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                overflow: elide;
            }
        }
    }
}
